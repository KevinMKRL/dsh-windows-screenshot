{
  "name": "dsh-windows-screenshot",
  "version": "1.0.1",
  "description": "Windows-native area, window, and full-screen screenshots with delay, attached directly to the DeepSeek Harness composer.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "host/screenshot.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "README.md",
    "README.zh.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "icon.svg",
    "screenshots.json"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "screenshot",
    "snip",
    "screen-capture",
    "windows",
    "composer"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KevinMKRL/dsh-windows-screenshot.git"
  },
  "bugs": {
    "url": "https://github.com/KevinMKRL/dsh-windows-screenshot/issues"
  },
  "homepage": "https://github.com/KevinMKRL/dsh-windows-screenshot#readme",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "win32"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
